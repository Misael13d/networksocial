rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /usuarios/{userId} {
      allow read, write: if true;  // ⚠️ Solo para pruebas, cualquiera puede leer/escribir en usuarios
    }
    // Bloquea el resto de colecciones
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
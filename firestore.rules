rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Usuarios
    match /usuarios/{userId} {
      // Solo usuarios autenticados pueden ver perfiles
      allow read: if request.auth != null;
      // Cada usuario solo puede modificar su propio documento
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 2. Publicaciones
    match /publicaciones/{postId} {
      // Solo usuarios autenticados pueden leer publicaciones
      allow read: if request.auth != null;
      // Solo el autor puede crear o actualizar su publicación
      allow create, update: if request.auth != null
        && request.resource.data.autorId == request.auth.uid;
      // Solo el autor puede eliminar su publicación
      allow delete: if request.auth != null
        && resource.data.autorId == request.auth.uid;
    }

    // 3. Comentarios
    match /comentarios/{commentId} {
      allow read: if request.auth != null;
      // Solo el autor puede crear su comentario (y debe asignarse como autorId)
      allow create: if request.auth != null
        && request.resource.data.autorId == request.auth.uid;
      // Solo el autor puede actualizar o eliminar su comentario
      allow update, delete: if request.auth != null
        && resource.data.autorId == request.auth.uid;
    }

    // 4. Amigos (relaciones de amistad)
    match /amigos/{friendshipId} {
      // Solo pueden leer la relación los involucrados
      allow read: if request.auth != null
        && (resource.data.remitenteId == request.auth.uid
         || resource.data.destinatarioId == request.auth.uid);
      // El remitente puede crear la solicitud (se asigna a sí mismo)
      allow create: if request.auth != null
        && request.resource.data.remitenteId == request.auth.uid;
      // Solo el destinatario puede actualizar (ej. aceptar/rechazar)
      allow update: if request.auth != null
        && resource.data.destinatarioId == request.auth.uid;
      // Nadie puede eliminar una relación (puedes agregar allow delete si lo deseas)
      allow delete: if false;
    }

    // 5. Likes (reacciones a publicaciones)
    match /likes/{likeId} {
      allow read: if request.auth != null;
      // Un usuario solo puede crear un like con su propio uid
      allow create: if request.auth != null
        && request.resource.data.usuarioId == request.auth.uid;
      // Un usuario solo puede eliminar su propio like (dislike)
      allow delete: if request.auth != null
        && resource.data.usuarioId == request.auth.uid;
      // No se permite modificar un like (solo crear o eliminar)
      allow update: if false;
    }

    // 6. Regla comodín para cualquier otra colección no definida
    match /{document=**} {
      allow read, write: if false;
    }
  }
}